{
  "name": "github-mcp-oauth",
  "version": "1.0.0",
  "description": "GitHub MCP Server with OAuth Device Flow - Zero Hardcoded Credentials",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "github-mcp-oauth": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test-auth": "tsc && node dist/test-auth.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "github",
    "oauth",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@octokit/rest": "^21.0.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
